<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lwr_description</name>
  <version>2.0.0</version>
  <description>The lwr_description package contains the model of a KUKA LWR 4+ arm.</description>

  <maintainer email="cjrosale@gmail.com">Carlos J. Rosales</maintainer>

  <license>GPLv2</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>lwr_hw</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>hardware_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- lets gazebo resolve the package://lwr_description/meshes/... paths of the URDF -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
